[Unit]
Description=Delivery Camera MJPG Streamer on port 8081
After=network.target

[Service]
Type=simple
User=pi
ExecStartPre=-/usr/bin/fuser -k 8081/tcp
ExecStartPre=/bin/sleep 20
ExecStart=/usr/local/bin/mjpg_streamer -i "input_uvc.so -d /dev/v4l/by-id/usb-WCM_USB_WEB_CAM-video-index0 -r 640x360 -f 30" -o "output_http.so -p 8081 -w /usr/local/share/mjpg-streamer/www"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
